{
  "uid": "agno-observability",
  "title": "Agno observability",
  "description": "Generic run metrics and logs for one monitored project.",
  "tags": ["agno", "observability"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "project_id",
        "label": "Project",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(agno_runs_total, project_id)",
        "query": {"query": "label_values(agno_runs_total, project_id)", "refId": "project_id"},
        "refresh": 1,
        "current": {}
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(agno_runs_total{project_id=\"$project_id\"}, environment)",
        "query": {"query": "label_values(agno_runs_total{project_id=\"$project_id\"}, environment)", "refId": "environment"},
        "refresh": 1,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Run rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(agno_runs_total{project_id=\"$project_id\",environment=\"$environment\"}[5m]))"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 2,
      "title": "Error rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "(sum(rate(agno_runs_total{project_id=\"$project_id\",environment=\"$environment\",status=\"error\"}[5m])) or vector(0)) / clamp_min(sum(rate(agno_runs_total{project_id=\"$project_id\",environment=\"$environment\"}[5m])), 0.001)"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 3,
      "title": "P95 run duration",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(agno_run_duration_seconds_bucket{project_id=\"$project_id\",environment=\"$environment\"}[5m])))"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 4,
      "title": "Logs",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"refId": "A", "expr": "{project_id=\"$project_id\",environment=\"$environment\"}"}],
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 16},
      "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false}
    }
  ]
}
