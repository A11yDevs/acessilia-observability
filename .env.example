# Kept on the observability server. Use a strong password even when the UI is bound to loopback.
GRAFANA_ADMIN_PASSWORD=

# Optional read-only AgentOS credential. Never put it in config.py.
AGENTOS_TOKEN=

# Central: create three different random tokens (openssl rand -hex 32).
OBS_VIEW_TOKEN=
OBS_INGEST_TOKEN=
OBS_HOST_TOKEN=
OBS_ENVIRONMENT=develop
OBS_RETENTION_DAYS=7
OBS_MAX_EVENTS=100000
OBS_ENABLE_TEST_CONSOLE=false

# Base URLs; no /api/v1 or /v1 suffix. Empty means not configured.
ACESSILIA_API_URL=
ACESSILIA_OBSERVABILITY_TOKEN=
TOOLBOX_API_URL=
TOOLBOX_API_KEY=
AGENTOS_URL=

# Set on application/host machines, not required by the central container.
OBS_CENTRAL_URL=
OBS_HOST_ID=
# Optional mapping for identifying service processes, using their actual PIDs.
OBS_SERVICE_PIDS=
